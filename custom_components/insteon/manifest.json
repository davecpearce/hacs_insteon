{
  "domain": "insteon",
  "name": "Insteon",
  "after_dependencies": ["panel_custom"],
  "codeowners": ["@teharris1", "@ssyrell", "@connorgallopo"],
  "config_flow": true,
  "dependencies": ["http", "usb", "websocket_api"],
  "dhcp": [
    {
      "macaddress": "000EF3*"
    },
    {
      "registered_devices": true
    }
  ],
  "documentation": "https://github.com/davecpearce/hacs_insteon",
  "integration_type": "hub",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/davecpearce/hacs_insteon/issues",
  "loggers": ["pyinsteon", "pypubsub"],
  "requirements": ["pyinsteon==1.6.4", "insteon-frontend-home-assistant==0.6.2"],
  "single_config_entry": true,
  "usb": [
    {
      "vid": "10BF"
    }
  ],
  "version": "1.1.3"
}
